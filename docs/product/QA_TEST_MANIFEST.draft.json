    {
      "id": "S-QA-08",
      "name": "visual_a11y",
      "level": "visual/accessibility",
      "files": ["screen_inventory_subset", "design_system_states"],
      "trigger": "rc"
    },
    {
      "id": "S-QA-09",
      "name": "security_negative",
      "level": "security",
      "files": ["SEC-A01..20", "OWASP_controls"],
      "trigger": "every_security_or_release_change"
    },
    {
      "id": "S-QA-10",
      "name": "load_queue",
      "level": "performance",
      "files": ["dashboard", "attendance", "payroll", "reports", "jobs"],
      "trigger": "beta_and_scale_gate"
    },
    {
      "id": "S-QA-11",
      "name": "backup_restore",
      "level": "dr",
      "files": ["PITR", "tenant_export", "restore_runbook"],
      "trigger": "production_readiness_and_quarterly"
    }
