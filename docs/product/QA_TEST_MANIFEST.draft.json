{
  "schema_version": "0.1.0",
  "catalog_version": "draft-2026-09-08",
  "status": "proposal",
  "runtime_enabled": false,
  "baseline": {
    "unit_runner": "vitest",
    "e2e_runner": "playwright",
    "browser_projects": ["chromium", "mobile-chrome"],
    "locale": "ar-SA",
    "timezone": "Asia/Riyadh",
    "demo_mode": "VITE_ENABLE_DEMO_MODE=true",
    "coverage_config": "vitest.config.ts",
    "e2e_config": "playwright.config.ts"
  },
  "levels": [
    {
      "id": "unit",
      "tool": "vitest",
      "environment": "node",
      "gate": "pr",
      "coverage_target": {
        "statements": 0.95,
        "branches": 0.9
      }
    },
    {
      "id": "component",
      "tool": "vitest+testing-library",
      "environment": "jsdom",
      "gate": "ui_pr",
      "coverage_target": {
        "states": "all_primary"
      }
    },
    {
      "id": "contract",
      "tool": "vitest+pglite",
      "environment": "ephemeral_db",
      "gate": "pr",
      "coverage_target": {
        "manifest": "100%"
      }
    },
    {
      "id": "integration",
      "tool": "vitest+supabase_test",
      "environment": "staging_like",
      "gate": "domain_pr",
      "coverage_target": {
        "critical_paths": "100%"
      }
    },
    {
      "id": "api",
      "tool": "typed_api_harness",
      "environment": "staging",
      "gate": "release_candidate",
      "coverage_target": {
        "endpoints": "100%"
      }
    },
    {
      "id": "e2e",
      "tool": "playwright",
      "environment": "demo_and_staging",
      "gate": "release_candidate",
      "coverage_target": {
        "journeys": "12/12_smoke"
      }
    },
    {
      "id": "visual",
      "tool": "playwright_screenshots",
      "environment": "staging",
      "gate": "release_candidate",
      "coverage_target": {
        "critical_views": "100%"
      }
    },
    {
      "id": "accessibility",
      "tool": "axe+keyboard_manual",
      "environment": "staging",
      "gate": "release_candidate",
      "coverage_target": {
        "serious_violations": 0
      }
    },
    {
      "id": "performance",
      "tool": "lighthouse+k6+explain",
      "environment": "staging",
      "gate": "beta_scale",
      "coverage_target": {
        "p95_targets": "defined_in_part_13"
      }
    },
    {
      "id": "security",
      "tool": "SAST/SCA/fuzz/replay",
      "environment": "ci_and_staging",
      "gate": "pilot_release",
      "coverage_target": {
        "SEC_cases": "20/20"
      }
    },
    {
      "id": "dr",
      "tool": "restore_and_chaos_runbook",
      "environment": "isolated_staging",
      "gate": "production_readiness",
      "coverage_target": {
        "restore_drill": "pass"
      }
    }
  ],
  "module_matrix": [
    {
      "module_id": "auth_rbac",
