  "suites": [
    {
      "id": "S-QA-01",
      "name": "core_unit",
      "level": "unit",
      "files": [
        "src/lib/auth",
        "src/lib/utils/payroll-calculator.ts",
        "src/lib/utils/eosb-calculator.ts",
        "src/lib/business/*"
      ],
      "trigger": "every_pr"
    },
    {
      "id": "S-QA-02",
      "name": "contract_migrations",
      "level": "contract",
      "files": ["supabase/migrations", "src/tests/*schema*", "src/tests/*transaction*"],
      "trigger": "migration_or_business_change"
    },
    {
      "id": "S-QA-03",
      "name": "api_contract",
      "level": "api",
      "files": ["API_CONTRACT_MANIFEST.draft.json"],
      "trigger": "api_or_policy_change"
