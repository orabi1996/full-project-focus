# Supabase Configuration for Enterprise HRMS
# Replace these values with your actual project credentials from https://supabase.com/dashboard
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# Optional Node SSR environment variables
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# Available only in non-production builds and only when explicitly set to true.
# Production builds always disable Demo Mode even if this value is accidentally left enabled.
VITE_ENABLE_DEMO_MODE=true

# Required for Saudi WPS/SIF export (the establishment's salary-transfer bank code)
VITE_WPS_EMPLOYER_BANK_CODE=YOUR_BANK_CODE
