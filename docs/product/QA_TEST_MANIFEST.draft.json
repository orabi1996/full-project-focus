  "coverage_gates": {
    "critical_calculators": {
      "statements": 0.95,
      "branches": 0.9
    },
    "server_functions_minimum": {
      "statements": 0.85,
      "branches": 0.75
    },
    "api_manifest": "100% success/auth/validation/idempotency where applicable",
    "security": "20/20",
    "a11y": "zero critical_or_serious",
    "e2e": "12 journeys smoke"
  },
  "performance_targets": {
    "dashboard_p95_ms": 2000,
    "list_api_p95_ms": 500,
    "fast_command_p95_ms": 800,
    "queue_age": "within workflow SLA"
  },
  "environments": [
    "ephemeral_unit",
    "pglite_contract",
    "supabase_staging",
    "provider_sandbox",
    "production_smoke"
  ],
  "defect_policy": {
    "P0": "data/payment exposure or loss; block immediately",
    "P1": "critical financial/journey failure; block release",
    "P2": "workaround or noncritical feature; backlog",
    "P3": "cosmetic/copy; no pilot block unless a11y/brand"
  },
  "flaky_policy": [
    "owner_and_expiry_required",
    "retry_does_not_hide_failure",
    "quarantine_needs_ticket",
    "redacted_artifacts_only"
  ],
  "release_exit_criteria": [
    "zero_open_P0_P1",
    "SEC-A01..20 pass_or_expired_exception",
    "critical_workflows_green",
    "coverage_gates_met",
    "a11y_serious_zero",
    "performance_budget_green",
    "restore_evidence",
    "rollback_runbook"
  ],
  "open_decisions": [
    "testing_library_for_components",
