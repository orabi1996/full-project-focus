      "name": "tenant_rls",
      "level": "integration",
      "files": ["tenant_context", "RLS_policies"],
      "trigger": "data_or_permission_change"
    },
    {
      "id": "S-QA-05",
      "name": "attendance_finance_integration",
      "level": "integration",
      "files": ["punches", "leave", "payroll", "payments", "settlement"],
      "trigger": "critical_domain_change"
    },
    {
      "id": "S-QA-06",
      "name": "e2e_desktop_smoke",
