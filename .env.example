# ==============================================================================
# MadarX Enterprise Workforce Platform — Environment Configuration Contract
# This template defines ALL supported environment variables for Release v1.0.0-enterprise.
# VARIABLE NAMES ONLY — DO NOT COMMIT REAL CREDENTIAL VALUES OR SECRETS TO GIT.
#
# SUPABASE API KEY MODEL (MODERN PUBLISHABLE / SECRET CONTRACT):
# - Client/Browser: VITE_SUPABASE_URL + VITE_SUPABASE_PUBLISHABLE_KEY
# - Trusted Server: SUPABASE_URL + SUPABASE_SECRET_KEY
# - Legacy VITE_SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are REMOVED/DEPRECATED.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC CLIENT / BROWSER RUNTIME (Safe for Client Bundle under RLS)
# ------------------------------------------------------------------------------
# [Required Production] Supabase Project URL (HTTPS protocol required in production)
VITE_SUPABASE_URL=

# [Required Production] Supabase Publishable Browser Key (sb_publishable_* — NEVER provide secret key!)
VITE_SUPABASE_PUBLISHABLE_KEY=

# [Required Production] Demo Mode Switch (MUST be false in production; true permitted ONLY for offline/dev)
VITE_ENABLE_DEMO_MODE=false

# [Optional Production] Canonical Web App URL (Used for auth redirects and email links)
VITE_APP_URL=

# [Optional Production] Saudi WPS/SIF Bank Code (Establishment salary transfer code)
VITE_WPS_EMPLOYER_BANK_CODE=

# [Optional Production] Storage Bucket Name for Employee & Legal Documents (Default: documents)
VITE_STORAGE_BUCKET_DOCS=documents

# ------------------------------------------------------------------------------
# 2. TRUSTED SERVER & RUNTIME CONFIGURATION (Node / Nitro SSR ONLY — NEVER EXPOSE TO CLIENT)
# ------------------------------------------------------------------------------
# [Required Production] Application Runtime Environment (production | development | test)
NODE_ENV=production

# [Required Server] Server-side Supabase Project URL (HTTPS protocol required in production)
SUPABASE_URL=

# [Required Server Secret] Supabase Secret Key (sb_secret_* — Bypasses RLS; server routes/workers ONLY)
SUPABASE_SECRET_KEY=

# [Optional SSR Fallback] Server-side Supabase Publishable Key (mirrors VITE_SUPABASE_PUBLISHABLE_KEY)
SUPABASE_PUBLISHABLE_KEY=

# [Optional Server Secret] Direct PostgreSQL Database Connection String (For Supabase CLI / migrations only)
DATABASE_URL=

# [Optional Server Secret] Database Superuser Password (For Supabase CLI / migrations only)
POSTGRES_PASSWORD=

# [Optional Server Secret] Webhook Ingress HMAC Signing Secret
WEBHOOK_SIGNING_SECRET=

# ------------------------------------------------------------------------------
# 3. ENTERPRISE AI PROVIDER CONFIGURATION (Server-Only — Optional)
#    NEVER expose these keys with a VITE_ prefix in client bundles.
# ------------------------------------------------------------------------------
# [Optional Server-Only] Primary LLM Provider (mock_safe | openai | anthropic | gemini)
MADARX_AI_PROVIDER=mock_safe

# [Optional Server-Only] OpenAI API Key for Server-Side Copilot Gateway
OPENAI_API_KEY=

# [Optional Server-Only] Anthropic API Key for Server-Side Copilot Gateway
ANTHROPIC_API_KEY=

# [Optional Server-Only] Google Gemini API Key for Server-Side Copilot Gateway
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 4. OPTIONAL EXTERNAL GOVERNMENT & CORPORATE INTEGRATIONS (Server-Only)
#    Do NOT block MadarX Core Go-Live when unconfigured; activate per tenant when ready.
# ------------------------------------------------------------------------------
# Saudi Arabia (GOSI, Mudad, Qiwa, Muqeem)
MADARX_SA_GOSI_CLIENT_ID=
MADARX_SA_GOSI_CLIENT_SECRET=
MADARX_SA_GOSI_MTLS_CERT_REF=
MADARX_SA_MUDAD_CLIENT_ID=
MADARX_SA_MUDAD_API_SECRET=
MADARX_SA_QIWA_ESTABLISHMENT_TOKEN=
MADARX_SA_MUQEEM_PORTAL_REF=

# Egypt (NOSI, ETA)
MADARX_EG_NOSI_ESTABLISHMENT_REF=
MADARX_EG_ETA_CLIENT_ID=
MADARX_EG_ETA_CLIENT_SECRET=
MADARX_EG_ETA_SIGNING_CERT_REF=

# Qatar (GRSIA, MADLSA)
MADARX_QA_GRSIA_EMPLOYER_REF=
MADARX_QA_MADLSA_WPS_ESTABLISHMENT_ID=

# Oman (SPF, CBO)
MADARX_OM_SPF_EMPLOYER_REF=
MADARX_OM_CBO_WPS_EMPLOYER_CR=

# Bahrain (SIO, LMRA)
MADARX_BH_SIO_EMPLOYER_REF=
MADARX_BH_LMRA_ESTABLISHMENT_CR=

# Corporate SMTP Relay (Optional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# ------------------------------------------------------------------------------
# 5. AUTOMATED TEST SUITE IDENTITIES (CI / Local Testing Only)
# ------------------------------------------------------------------------------
SUPABASE_TEST_HR_A_EMAIL=
SUPABASE_TEST_HR_A_PASSWORD=
SUPABASE_TEST_EMPLOYEE_A_EMAIL=
SUPABASE_TEST_EMPLOYEE_A_PASSWORD=
SUPABASE_TEST_MANAGER_A_EMAIL=
SUPABASE_TEST_MANAGER_A_PASSWORD=
SUPABASE_TEST_HR_B_EMAIL=
SUPABASE_TEST_HR_B_PASSWORD=
