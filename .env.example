# ==============================================================================
# MadarX Enterprise Workforce Platform — Production Environment Contract
# Release: v1.0.0-enterprise
#
# SECURITY & COMPLIANCE RULES:
# 1. VARIABLE NAMES ONLY — NEVER COMMIT REAL PASSWORDS, TOKENS, OR SECRETS TO GIT.
# 2. MODERN SUPABASE KEY MODEL ONLY:
#    - Client/Browser: VITE_SUPABASE_URL + VITE_SUPABASE_PUBLISHABLE_KEY
#    - Trusted Server Only: SUPABASE_URL + SUPABASE_SECRET_KEY
#    - Legacy VITE_SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are DEPRECATED/REMOVED.
# 3. Client bundle safety: Variables prefixed with VITE_ are public. NEVER prefix server secrets with VITE_.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND PUBLIC (Browser Runtime — Safe under Row Level Security)
# ------------------------------------------------------------------------------
# [Required Production] HTTPS Supabase project URL
VITE_SUPABASE_URL=

# [Required Production] Supabase Publishable Key (sb_publishable_*)
VITE_SUPABASE_PUBLISHABLE_KEY=

# [Required Production] Demo Mode Switch (MUST be false in production)
VITE_ENABLE_DEMO_MODE=false

# [Optional Production] Canonical Web App URL (Used for auth redirects and email links)
VITE_APP_URL=https://app.madarx.com

# [Optional Production] Saudi WPS/SIF Bank Code (Establishment salary transfer code)
VITE_WPS_EMPLOYER_BANK_CODE=

# [Optional Production] Storage Bucket Name for Employee & Legal Documents (Default: documents)
VITE_STORAGE_BUCKET_DOCS=documents

# ------------------------------------------------------------------------------
# 2. BACKEND SECRET (Trusted Server Runtime — Node / Nitro SSR Only)
# ------------------------------------------------------------------------------
# [Required Production] Application Runtime Environment (production | development | test)
NODE_ENV=production

# [Optional Server Secret] Application Encryption Master Key (32-byte hex for field-level encryption)
APPLICATION_MASTER_KEY=

# ------------------------------------------------------------------------------
# 3. DATABASE (Direct Connection for Migrations & High-Throughput Batch Jobs)
# ------------------------------------------------------------------------------
# [Optional Server Secret] Direct PostgreSQL Connection String (Supabase CLI / CI only)
DATABASE_URL=

# [Optional Server Secret] Database Superuser Password (For direct pooler connection)
POSTGRES_PASSWORD=

# ------------------------------------------------------------------------------
# 4. SUPABASE SERVER CONTRACT (Server Worker / Nitro API Ingress)
# ------------------------------------------------------------------------------
# [Required Server] Server-side Supabase Project URL
SUPABASE_URL=

# [Required Server Secret] Supabase Secret Key (sb_secret_* — Bypasses RLS for trusted batch operations)
SUPABASE_SECRET_KEY=

# [Optional Server] Mirror of publishable key for SSR runtime
SUPABASE_PUBLISHABLE_KEY=

# ------------------------------------------------------------------------------
# 5. EMAIL (Transactional Notifications, Password Resets & MFA)
# ------------------------------------------------------------------------------
# [Required for Live Email Delivery] Corporate SMTP Relay Host
SMTP_HOST=

# [Required for Live Email Delivery] Corporate SMTP Relay Port (587 or 465)
SMTP_PORT=587

# [Required for Live Email Delivery] Corporate SMTP Relay Username
SMTP_USER=

# [Required for Live Email Delivery] Corporate SMTP Relay Password
SMTP_PASS=

# [Required for Live Email Delivery] Transactional From Address
SMTP_FROM_EMAIL=notifications@madarx.com

# ------------------------------------------------------------------------------
# 6. STORAGE (Private Documents, Avatars, Vaults)
# ------------------------------------------------------------------------------
# Private Storage Bucket for Employee Sensitive Documents
STORAGE_BUCKET_EMPLOYEE_DOCS=employee-documents

# Private Storage Bucket for Corporate Legal Artifacts & Templates
STORAGE_BUCKET_COMPANY_DOCS=company-documents

# Private Storage Bucket for Finalized Payroll Export Archives & SIF Batches
STORAGE_BUCKET_PAYROLL_EXPORTS=payroll-exports

# ------------------------------------------------------------------------------
# 7. GOVERNMENT CONNECTORS (Multi-Country Regulatory Portals)
#    Operational State: WAITING_FOR_CUSTOMER_CREDENTIALS (Fail-Closed)
# ------------------------------------------------------------------------------
# Saudi Arabia (GOSI, Mudad, Qiwa, Muqeem)
MADARX_SA_GOSI_CLIENT_ID=
MADARX_SA_GOSI_CLIENT_SECRET=
MADARX_SA_GOSI_MTLS_CERT_REF=
MADARX_SA_MUDAD_CLIENT_ID=
MADARX_SA_MUDAD_API_SECRET=
MADARX_SA_QIWA_ESTABLISHMENT_TOKEN=
MADARX_SA_MUQEEM_PORTAL_REF=

# Egypt (NOSI, ETA)
MADARX_EG_NOSI_ESTABLISHMENT_REF=
MADARX_EG_ETA_CLIENT_ID=
MADARX_EG_ETA_CLIENT_SECRET=
MADARX_EG_ETA_SIGNING_CERT_REF=

# Qatar (GRSIA, MADLSA WPS)
MADARX_QA_GRSIA_EMPLOYER_REF=
MADARX_QA_MADLSA_WPS_ESTABLISHMENT_ID=

# Oman (SPF, CBO WPS)
MADARX_OM_SPF_EMPLOYER_REF=
MADARX_OM_CBO_WPS_EMPLOYER_CR=

# Bahrain (SIO, LMRA WPS)
MADARX_BH_SIO_EMPLOYER_REF=
MADARX_BH_LMRA_ESTABLISHMENT_CR=

# ------------------------------------------------------------------------------
# 8. AI (Enterprise AI Assistant & RAG Gateway — Server-Only)
# ------------------------------------------------------------------------------
# [Optional Server-Only] Active AI Provider (mock_safe | openai | anthropic | gemini)
MADARX_AI_PROVIDER=mock_safe

# [Optional Server-Only] OpenAI API Key
OPENAI_API_KEY=

# [Optional Server-Only] Anthropic API Key
ANTHROPIC_API_KEY=

# [Optional Server-Only] Google Gemini API Key
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 9. MONITORING (Sentry, OpenTelemetry & Logging)
# ------------------------------------------------------------------------------
# [Optional Production] Sentry Error Tracking DSN
SENTRY_DSN=

# [Optional Production] Application Log Level (debug | info | warn | error)
LOG_LEVEL=info

# [Optional Production] OpenTelemetry Collector Endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=

# ------------------------------------------------------------------------------
# 10. WEBHOOK (Ingress Signature Verification)
# ------------------------------------------------------------------------------
# [Optional Server Secret] HMAC SHA256 Webhook Signing Secret
WEBHOOK_SIGNING_SECRET=

# ------------------------------------------------------------------------------
# 11. OPTIONAL INTEGRATIONS (Biometric Attendance, Slack, Teams)
# ------------------------------------------------------------------------------
# [Optional] ZKTeco / Biometric Device Relay API Endpoint
BIOMETRIC_RELAY_ENDPOINT=
BIOMETRIC_RELAY_API_KEY=

# [Optional] Corporate Slack Webhook URL
SLACK_WEBHOOK_URL=

# [Optional] Microsoft Teams Notification Webhook URL
TEAMS_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# TEST SUITE CREDENTIALS (CI / Local Automated Testing Only)
# ------------------------------------------------------------------------------
SUPABASE_TEST_HR_A_EMAIL=
SUPABASE_TEST_HR_A_PASSWORD=
SUPABASE_TEST_EMPLOYEE_A_EMAIL=
SUPABASE_TEST_EMPLOYEE_A_PASSWORD=
SUPABASE_TEST_MANAGER_A_EMAIL=
SUPABASE_TEST_MANAGER_A_PASSWORD=
SUPABASE_TEST_HR_B_EMAIL=
SUPABASE_TEST_HR_B_PASSWORD=
