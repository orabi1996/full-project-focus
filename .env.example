# Supabase Configuration for Enterprise HRMS
# Replace these values with your actual project credentials from https://supabase.com/dashboard
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# Optional Node SSR environment variables
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# Available only in non-production builds and only when explicitly set to true.
# Production builds always disable Demo Mode even if this value is accidentally left enabled.
VITE_ENABLE_DEMO_MODE=true

# Required for Saudi WPS/SIF export (the establishment's salary-transfer bank code)
VITE_WPS_EMPLOYER_BANK_CODE=YOUR_BANK_CODE

# Automated Test Identities (Placeholder names only - DO NOT commit real credentials)
SUPABASE_TEST_HR_A_EMAIL=hr_a_test@example.com
SUPABASE_TEST_HR_A_PASSWORD=placeholder_hr_a_password
SUPABASE_TEST_EMPLOYEE_A_EMAIL=employee_a_test@example.com
SUPABASE_TEST_EMPLOYEE_A_PASSWORD=placeholder_emp_a_password
SUPABASE_TEST_MANAGER_A_EMAIL=manager_a_test@example.com
SUPABASE_TEST_MANAGER_A_PASSWORD=placeholder_manager_a_password
SUPABASE_TEST_HR_B_EMAIL=hr_b_test@example.com
SUPABASE_TEST_HR_B_PASSWORD=placeholder_hr_b_password
# SUPABASE_SERVICE_ROLE_KEY=placeholder_service_role_key

