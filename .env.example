# ==============================================================================
# MadarX Enterprise Workforce Platform — Environment Configuration Contract
# This template defines ALL supported environment variables for Core v1.
# VARIABLE NAMES ONLY — DO NOT COMMIT REAL CREDENTIAL VALUES OR SECRETS TO GIT.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC FRONTEND (Browser & Client Bundle)
# ------------------------------------------------------------------------------
# [Required Production] Supabase Project URL (HTTPS protocol required in production)
VITE_SUPABASE_URL=

# [Required Production] Supabase Public/Anon Browser Key (Public key ONLY; never provide service-role key!)
VITE_SUPABASE_PUBLISHABLE_KEY=

# [Required Production] Demo Mode Switch (MUST be false in production; true permitted ONLY for offline/dev)
VITE_ENABLE_DEMO_MODE=

# [Optional Production] Canonical Web App URL (Used for auth redirects and email links)
VITE_APP_URL=

# [Optional Production] Saudi WPS/SIF Bank Code (Establishment salary transfer code)
VITE_WPS_EMPLOYER_BANK_CODE=

# [Optional Production] Storage Bucket Name for Employee & Legal Documents (Default: documents)
VITE_STORAGE_BUCKET_DOCS=

# ------------------------------------------------------------------------------
# 2. SERVER & RUNTIME CONFIGURATION (Node / Nitro SSR)
# ------------------------------------------------------------------------------
# [Required Production] Application Runtime Environment (production | development | test)
NODE_ENV=

# [Optional SSR] Server-side Supabase URL fallback (mirrors VITE_SUPABASE_URL)
SUPABASE_URL=

# [Optional SSR] Server-side Supabase Publishable Key fallback (mirrors VITE_SUPABASE_PUBLISHABLE_KEY)
SUPABASE_PUBLISHABLE_KEY=

# ------------------------------------------------------------------------------
# 3. SERVER SECRETS (Backend & Admin Runtimes ONLY - NEVER EXPOSE TO CLIENT)
# ------------------------------------------------------------------------------
# [Server Secret] Supabase Service-Role Admin Key (Bypasses RLS; ONLY for secure server workers/scripts)
SUPABASE_SERVICE_ROLE_KEY=

# [Server Secret] Direct PostgreSQL Database Connection String (For migration tools / Supabase CLI)
DATABASE_URL=

# [Server Secret] Database Superuser Password
POSTGRES_PASSWORD=

# [Server Secret] Webhook Ingress HMAC Signing Secret
WEBHOOK_SIGNING_SECRET=

# ------------------------------------------------------------------------------
# 4. OPTIONAL INTEGRATIONS & EXTERNAL GATEWAYS
# ------------------------------------------------------------------------------
# [Optional Integration] Qiwa Gateway Client ID
QIWA_CLIENT_ID=

# [Optional Integration] Qiwa Gateway Secret Key
QIWA_CLIENT_SECRET=

# [Optional Integration] GOSI API Endpoint Base URL
GOSI_API_BASE_URL=

# [Optional Integration] Muqeem Gateway API Key
MUQEEM_API_KEY=

# [Optional Integration] Mudad Payroll Integration Client ID
MUDAD_CLIENT_ID=

# [Optional Integration] Corporate SMTP Server Host (For email notifications)
SMTP_HOST=

# [Optional Integration] Corporate SMTP Server Port
SMTP_PORT=

# [Optional Integration] Corporate SMTP Username
SMTP_USER=

# [Optional Integration] Corporate SMTP Password
SMTP_PASS=

# ------------------------------------------------------------------------------
# 5. AUTOMATED TEST SUITE IDENTITIES (CI / Local Testing Only)
# ------------------------------------------------------------------------------
# [Optional Test] Company A - HR Admin Test User Email
SUPABASE_TEST_HR_A_EMAIL=

# [Optional Test] Company A - HR Admin Test User Password
SUPABASE_TEST_HR_A_PASSWORD=

# [Optional Test] Company A - Employee Test User Email
SUPABASE_TEST_EMPLOYEE_A_EMAIL=

# [Optional Test] Company A - Employee Test User Password
SUPABASE_TEST_EMPLOYEE_A_PASSWORD=

# [Optional Test] Company A - Line Manager Test User Email
SUPABASE_TEST_MANAGER_A_EMAIL=

# [Optional Test] Company A - Line Manager Test User Password
SUPABASE_TEST_MANAGER_A_PASSWORD=

# [Optional Test] Company B - HR Admin Test User Email
SUPABASE_TEST_HR_B_EMAIL=

# [Optional Test] Company B - HR Admin Test User Password
SUPABASE_TEST_HR_B_PASSWORD=
