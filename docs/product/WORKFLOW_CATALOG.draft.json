{
  "schema_version": "0.1.0",
  "catalog_version": "draft-2026-09-08",
  "status": "proposal",
  "runtime_enabled": false,
  "description_ar": "كتالوج مبدئي لمسارات الأعمال؛ المرجع النصي يشرح القواعد ولا يفعّل runtime.",
  "states": [
    {
      "id": "draft",
      "terminal": false,
      "description_ar": "مسودة لم تُرسل"
    },
    {
      "id": "submitted",
      "terminal": false,
      "description_ar": "أُرسلت وتجاوزت التحقق الأولي"
    },
    {
      "id": "pending_approval",
      "terminal": false,
      "description_ar": "تنتظر موافقة"
    },
    {
      "id": "approved",
      "terminal": false,
      "description_ar": "اكتملت الموافقات"
    },
    {
      "id": "processing",
      "terminal": false,
      "description_ar": "قيد التنفيذ"
    },
    {
      "id": "completed",
      "terminal": true,
      "description_ar": "اكتمل الأثر والمطابقة"
    },
    {
      "id": "returned",
      "terminal": false,
      "description_ar": "أعيدت للمُنشئ"
    },
    {
      "id": "rejected",
      "terminal": true,
      "description_ar": "رُفض نهائيًا"
    },
    {
      "id": "failed_retryable",
      "terminal": false,
      "description_ar": "فشل مؤقت قابل لإعادة المحاولة"
    },
    {
      "id": "failed_terminal",
      "terminal": true,
      "description_ar": "فشل يحتاج تدخلًا"
    },
    {
      "id": "cancelled",
      "terminal": true,
      "description_ar": "أُلغي قبل الأثر غير القابل للعكس"
    },
    {
      "id": "expired",
      "terminal": false,
      "description_ar": "انتهت مهلة SLA"
    },
    {
      "id": "locked",
      "terminal": false,
      "description_ar": "مقفل أثناء التسوية"
    }
  ],
  "common_guards": [
    {
      "id": "tenant_context",
      "rule": "tenant_id من session/token ويُفرض في كل query وRLS"
    },
    {
      "id": "effective_date",
      "rule": "لا تعديل على فترة مقفلة؛ التصحيح adjustment أو reversal"
    },
    {
      "id": "rbac_sod",
      "rule": "تطبيق role scope وSoD ومنع self approval"
    },
    {
      "id": "optimistic_lock",
      "rule": "version check يمنع الكتابة فوق تعديل متزامن"
    },
    {
      "id": "idempotency",
      "rule": "مفتاح مركب tenant/actor/business_reference/operation"
    },
    {
      "id": "outbox_inbox",
      "rule": "نشر الأحداث من outbox وإزالة التكرار عبر event_id"
    },
    {
      "id": "privacy",
      "rule": "الإشعار رابط وملخص عام؛ التفاصيل في جلسة مصادق عليها"
    },
    {
      "id": "time_locale",
      "rule": "التخزين UTC وعرض timezone المؤسسة واللغة المختارة"
    },
    {
      "id": "break_glass",
      "rule": "وصول مؤقت بسبب وموافقة وأثر تدقيق"
    }
  ],
  "approval_contract": {
    "type": "versioned_chain",
    "role_scope_effective_date": true,
    "self_approval_default": false,
    "delegation_requires_end_date": true,
    "wildcard_approver_allowed": false,
    "missing_approver_state": "blocked_no_approver",
    "decision_comment_required_by_policy": true,
    "decision_idempotent": true
  },
